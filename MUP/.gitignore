# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
venv_old/

# Generated live data (keep source datasets trackable)
data/live_feed.csv
data/memory_predictions.csv

