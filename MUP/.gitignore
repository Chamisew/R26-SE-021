logs/*
!logs/comparison_results.csv
!logs/compare.log
!logs/lopo_results.csv

# Regenerable trained model binaries
models/*.pkl
models/*.joblib

# Build artifacts and installed dependencies
build/
dist/
node_modules/
**/site-packages/
**/dist-info/
**/*.egg/
*.so
*.pyd
*.dll
*.a
*.o
*.lib
